[Desktop Entry]
Type=Application
Name=Neko Pad
GenericName=Text Editor
Comment=A fast text and source code editor
Exec=nekopad %F
Icon=nekopad
Terminal=false
Categories=Utility;TextEditor;Development;Qt;
MimeType=text/plain;text/x-c++src;text/x-csrc;text/x-chdr;text/x-c++hdr;text/x-python;text/x-shellscript;application/json;application/xml;text/html;text/css;text/markdown;text/x-cmake;application/x-yaml;
StartupWMClass=nekopad
Keywords=text;editor;code;notepad;
