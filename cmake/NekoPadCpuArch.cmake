# NEKOPAD_CPU_ARCH: the target CPU microarchitecture, as Neko Note does it.
include_guard(GLOBAL)
# Target CPU microarchitecture: x86-64-v2 baseline on x86-64, with options for v3, v4,
# host-specific optimization (native), or none to leave architecture flags to the caller.
set(_nekopad_target_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_GENERATOR_PLATFORM)
    set(_nekopad_target_arch "${CMAKE_GENERATOR_PLATFORM}")
endif()
set(_nekopad_is_x86_64 FALSE)
if(CMAKE_SIZEOF_VOID_P EQUAL 8 AND _nekopad_target_arch MATCHES "^(x86_64|AMD64|amd64|x64|X64)$")
    set(_nekopad_is_x86_64 TRUE)
endif()
set(_nekopad_default_cpu_arch "none")
if(_nekopad_is_x86_64)
    set(_nekopad_default_cpu_arch "x86-64-v2")
endif()
set(NEKOPAD_CPU_ARCH "${_nekopad_default_cpu_arch}" CACHE STRING
    "Target CPU microarchitecture (x86-64-v2, x86-64-v3, x86-64-v4, native, none)")
set_property(CACHE NEKOPAD_CPU_ARCH PROPERTY STRINGS "x86-64-v2" "x86-64-v3" "x86-64-v4" "native" "none")

string(TOLOWER "${NEKOPAD_CPU_ARCH}" _nekopad_cpu_arch)
if(NOT _nekopad_cpu_arch MATCHES "^(x86-64-v2|x86-64-v3|x86-64-v4|native|none)$")
    message(FATAL_ERROR "Invalid NEKOPAD_CPU_ARCH='${NEKOPAD_CPU_ARCH}'. "
                        "Expected one of: x86-64-v2, x86-64-v3, x86-64-v4, native, none")
endif()

set(_nekopad_cpu_arch_flag "")
if(_nekopad_cpu_arch STREQUAL "none")
    # Leave CPU architecture flags to the toolchain / caller.
elseif(NOT _nekopad_is_x86_64 AND NOT _nekopad_cpu_arch STREQUAL "native")
    message(WARNING "NEKOPAD_CPU_ARCH=${NEKOPAD_CPU_ARCH} only applies to x86-64 targets "
                    "(ignored on ${_nekopad_target_arch})")
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    if(_nekopad_cpu_arch STREQUAL "x86-64-v2")
        include(CheckCXXCompilerFlag)
        check_cxx_compiler_flag("/arch:SSE4.2" NEKOPAD_MSVC_HAS_ARCH_SSE42)
        if(NEKOPAD_MSVC_HAS_ARCH_SSE42)
            set(_nekopad_cpu_arch_flag "/arch:SSE4.2")
        else()
            message(WARNING "MSVC does not support /arch:SSE4.2 (requires Visual Studio 2022 17.10+); "
                            "falling back to MSVC default x64 baseline (SSE2)")
        endif()
    elseif(_nekopad_cpu_arch STREQUAL "x86-64-v3")
        set(_nekopad_cpu_arch_flag "/arch:AVX2")
    elseif(_nekopad_cpu_arch STREQUAL "x86-64-v4")
        set(_nekopad_cpu_arch_flag "/arch:AVX512")
    elseif(_nekopad_cpu_arch STREQUAL "native")
        message(WARNING "MSVC does not support native CPU optimization; "
                        "use x86-64-v3 or x86-64-v4 to target a higher instruction set")
        if(_nekopad_is_x86_64)
            include(CheckCXXCompilerFlag)
            check_cxx_compiler_flag("/arch:SSE4.2" NEKOPAD_MSVC_HAS_ARCH_SSE42)
            if(NEKOPAD_MSVC_HAS_ARCH_SSE42)
                set(_nekopad_cpu_arch_flag "/arch:SSE4.2")
            endif()
        endif()
    endif()
elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
    if(_nekopad_cpu_arch STREQUAL "native")
        if(_nekopad_target_arch MATCHES "^(aarch64|arm64|ARM64)$")
            set(_nekopad_arch_opt "-mcpu=native")
        else()
            set(_nekopad_arch_opt "-march=native")
        endif()
    else()
        set(_nekopad_arch_opt "-march=${_nekopad_cpu_arch}")
    endif()
    if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
        set(_nekopad_cpu_arch_flag "/clang:${_nekopad_arch_opt}")
    else()
        set(_nekopad_cpu_arch_flag "${_nekopad_arch_opt}")
    endif()
else()
    message(WARNING "Unsupported compiler '${CMAKE_CXX_COMPILER_ID}' for NEKOPAD_CPU_ARCH=${NEKOPAD_CPU_ARCH}; "
                    "no CPU architecture flag applied")
endif()

if(_nekopad_cpu_arch_flag)
    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:${_nekopad_cpu_arch_flag}>)
    message(STATUS "CPU architecture: ${_nekopad_cpu_arch} (${_nekopad_cpu_arch_flag})")
else()
    message(STATUS "CPU architecture: ${_nekopad_cpu_arch} (no compiler flag)")
endif()
